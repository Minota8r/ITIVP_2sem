PORT=3000

# PostgreSQL в Docker
POSTGRES_USER=board
POSTGRES_PASSWORD=board
POSTGRES_DB=board
POSTGRES_PORT=5433

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

DATABASE_URL=postgres://board:board@localhost:5433/board

# Секрет для подписи JWT
JWT_SECRET=change-me

CLIENT_ORIGIN=http://localhost:5173

# MongoDB в Docker (ЛР6)
MONGO_USER=board
MONGO_PASSWORD=board
MONGO_DB_PORT=27017
MONGO_URI=mongodb://board:board@localhost:27017/board?authSource=admin
MONGO_PORT=3001
